# 仓库内统一 LF，检出时按平台处理 —— 避免整文件因为换行符产生假 diff
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper 在 Unix 上要能直接执行，换行符必须是 LF
gradlew text eol=lf
gradlew.bat text eol=crlf

# 二进制：不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.exe binary
*.apk binary
*.woff2 binary
