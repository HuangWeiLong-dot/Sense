{
  "name": "sense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sense — 完全本地运行的情感判断与建议工具（JEV 逐轮判断 + LLM 建议）",
  "author": "Sense",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "proxy": "node tools/cors-proxy.mjs",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:dev": "electron desktop/main.cjs --dev-url=http://localhost:5173",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "icon": "python tools/make-icon.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
